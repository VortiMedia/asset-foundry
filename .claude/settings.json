{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit(/assets.tsv)",
      "Bash(./find.sh *)",
      "Bash(./gen.sh)",
      "Bash(./gen.sh *)",
      "Bash(tests/run.sh)"
    ],
    "deny": [
      "Read(/.env)",
      "Edit(/.env)"
    ]
  }
}
