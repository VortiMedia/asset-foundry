{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit(/assets.tsv)",
      "Bash(./gen.sh)",
      "Bash(./gen.sh *)",
      "Bash(MODEL=openai/gpt-image-2 ./gen.sh)",
      "Bash(MODEL=openai/gpt-image-2 ./gen.sh *)",
      "Bash(MODEL=google/gemini-3.1-flash-image ./gen.sh)",
      "Bash(MODEL=google/gemini-3.1-flash-image ./gen.sh *)"
    ],
    "deny": [
      "Read(/.env)",
      "Edit(/.env)"
    ]
  }
}
